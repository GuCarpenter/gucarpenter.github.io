---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const normalize = (p: string) =>
  p !== "/" && p.endsWith("/") ? p.slice(0, -1) : p;

const pathname = normalize(
  Astro.url.pathname.replace(import.meta.env.BASE_URL, "/"),
);
const target = normalize(String(href));

const isActive =
  pathname === target || (target !== "/" && pathname.startsWith(target + "/"));
---

<a
  href={href}
  class:list={[className, { "text-primary": isActive }]}
  {...props}
>
  <slot />
</a>
