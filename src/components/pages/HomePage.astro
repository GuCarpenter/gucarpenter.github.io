---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../FormattedDate.astro";
import { calculateReadingTime } from "../../utils/readingTime";
import {
  useTranslations,
  localizePath,
  postUrl,
  type Lang,
} from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const blogHref = localizePath("/blog", lang);

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const categoryName = (id: string) =>
  id.includes("/")
    ? id
        .split("/")[0]
        .replace(/_/g, " ")
        .replace(/\b\w/g, (l) => l.toUpperCase())
    : t("home.articleFallback");
---

<Layout title={t("home.title")} lang={lang}>
  <section class="mb-12">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-6 text-slate-900 dark:text-slate-100">
      {t("home.hero.heading")}
    </h1>
    <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
      {t("home.hero.subtitle")}
    </p>
  </section>

  <div class="space-y-12">
    <h2 class="text-2xl font-bold border-b border-gray-100 dark:border-dark-border pb-4 text-slate-900 dark:text-slate-100">
      {t("home.latest")}
    </h2>

    <div class="grid gap-12">
      {posts.map((post) => {
        const category = post.id.includes("/") ? post.id.split("/")[0] : "";
        return (
          <article class="group relative flex flex-col space-y-4">
            <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
              <FormattedDate date={post.data.pubDate} lang={lang} />
              <span>•</span>
              <a
                href={`${blogHref}?topic=${category}`}
                class="text-sky-600 dark:text-sky-400 font-medium hover:underline z-10 relative"
              >
                {categoryName(post.id)}
              </a>
              <span>•</span>
              <span>
                {calculateReadingTime(post.body || "")} {t("blog.readingTime")}
              </span>
            </div>
            <h3 class="text-2xl font-bold group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors text-slate-900 dark:text-slate-100">
              <a
                href={postUrl(post.id, lang)}
                class="after:absolute after:inset-0"
              >
                {post.data.title}
              </a>
            </h3>
            <p class="text-slate-600 dark:text-slate-300 line-clamp-3">
              {post.data.description}
            </p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex gap-2 pt-2 z-10 relative">
                {post.data.tags.map((tag) => (
                  <a
                    href={`${blogHref}?topic=${tag}`}
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-50 text-sky-700 dark:bg-sky-900/20 dark:text-sky-300 border border-sky-100 dark:border-sky-900/30 hover:bg-sky-100 dark:hover:bg-sky-900/40 transition-colors"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>

    <div class="pt-8">
      <a
        href={blogHref}
        class="text-sky-600 dark:text-sky-400 font-medium hover:underline flex items-center gap-2"
      >
        {t("home.viewAll")}
        <i class="fas fa-arrow-right text-xs"></i>
      </a>
    </div>
  </div>
</Layout>
