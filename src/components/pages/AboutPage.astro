---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import guGreatWall from "../../assets/gu-great-wall.jpg";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// NOTE: Tailwind cannot detect dynamically-built class names, so full class
// strings are written out as literals here to keep them in the generated CSS.
const skills = [
  {
    name: "Python",
    iconClass: "fab fa-python text-3xl mb-2 text-yellow-500",
    barClass: "bg-yellow-500 h-full rounded-full",
    width: 90,
    level: "Expert",
  },
  {
    name: "C++",
    iconClass: null,
    barClass: "bg-blue-600 h-full rounded-full",
    width: 70,
    level: "Advanced",
  },
  {
    name: "C",
    iconClass: null,
    barClass: "bg-blue-600 h-full rounded-full",
    width: 50,
    level: "Intermediate",
  },
  {
    name: "TypeScript",
    iconClass: "fab fa-js text-3xl mb-2 text-yellow-400",
    barClass: "bg-yellow-400 h-full rounded-full",
    width: 50,
    level: "Intermediate",
  },
  {
    name: "Rust",
    iconClass: "fab fa-rust text-3xl mb-2 text-orange-500",
    barClass: "bg-orange-500 h-full rounded-full",
    width: 20,
    level: "Beginner",
  },
  {
    name: "Lua",
    iconClass: "fas fa-moon text-3xl mb-2 text-blue-400",
    barClass: "bg-blue-400 h-full rounded-full",
    width: 20,
    level: "Beginner",
  },
  {
    name: "SystemVerilog",
    iconClass: "fas fa-project-diagram text-3xl mb-2 text-gray-500",
    barClass: "bg-gray-500 h-full rounded-full",
    width: 25,
    level: "Beginner",
  },
  {
    name: "LLM",
    iconClass: "fas fa-brain text-3xl mb-2 text-purple-500",
    barClass: "bg-purple-500 h-full rounded-full",
    width: 90,
    level: "Expert",
  },
  {
    name: "Machine Learning",
    iconClass: "fas fa-microchip text-3xl mb-2 text-indigo-500",
    barClass: "bg-indigo-500 h-full rounded-full",
    width: 70,
    level: "Advanced",
  },
  {
    name: "Search Engine",
    iconClass: "fas fa-search text-3xl mb-2 text-blue-500",
    barClass: "bg-blue-500 h-full rounded-full",
    width: 60,
    level: "Intermediate",
  },
  {
    name: "Big Data",
    iconClass: "fas fa-database text-3xl mb-2 text-green-600",
    barClass: "bg-green-600 h-full rounded-full",
    width: 60,
    level: "Intermediate",
  },
  {
    name: "Megatron",
    iconClass: "fas fa-bolt text-3xl mb-2 text-yellow-600",
    barClass: "bg-yellow-600 h-full rounded-full",
    width: 85,
    level: "Advanced",
  },
  {
    name: "DeepSpeed",
    iconClass: "fas fa-tachometer-alt text-3xl mb-2 text-red-600",
    barClass: "bg-red-600 h-full rounded-full",
    width: 85,
    level: "Advanced",
  },
  {
    name: "PyTorch",
    iconClass: "fas fa-fire text-3xl mb-2 text-red-500",
    barClass: "bg-red-500 h-full rounded-full",
    width: 50,
    level: "Intermediate",
  },
  {
    name: "React",
    iconClass: "fab fa-react text-3xl mb-2 text-sky-400",
    barClass: "bg-sky-400 h-full rounded-full",
    width: 50,
    level: "Intermediate",
  },
  {
    name: "Astro",
    iconClass: "fas fa-rocket text-3xl mb-2 text-orange-600",
    barClass: "bg-orange-600 h-full rounded-full",
    width: 20,
    level: "Beginner",
  },
];
---

<Layout title={t("about.title")} lang={lang}>
  <header class="mb-10">
    <h1 class="text-4xl font-extrabold tracking-tight mb-6 text-slate-900 dark:text-slate-100">
      {t("about.heading")}
    </h1>
  </header>

  <div class="prose prose-lg dark:prose-invert mb-10 text-slate-600 dark:text-slate-300">
    <p class="lead text-xl font-medium text-slate-800 dark:text-slate-200">
      {t("about.p1")}
    </p>
    <p>{t("about.p2")}</p>
    <p>{t("about.p3")}</p>
    <p>{t("about.p4")}</p>
  </div>

  <div class="my-12">
    <Image
      src={guGreatWall}
      alt="Gu at Great Wall"
      class="rounded-3xl shadow-2xl w-full object-cover max-h-[500px]"
    />
  </div>

  <!-- Tech Stack Grid -->
  <div class="mt-16">
    <h3 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-6">
      {t("about.techStack")}
    </h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {skills.map((skill) => (
        <div class="flex flex-col items-center justify-center p-4 bg-white dark:bg-dark-surface border border-gray-100 dark:border-dark-border rounded-xl hover:shadow-md transition-all">
          {skill.iconClass ? (
            <i class={skill.iconClass} />
          ) : (
            <svg
              class="w-10 h-10 mb-2"
              viewBox="0 0 128 128"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M116.3 39.8L103.8 52.3C98.8 45.8 91.2 41.7 82.7 41.7C64.9 41.7 50.5 56.1 50.5 73.9C50.5 91.7 64.9 106.1 82.7 106.1C91.2 106.1 98.8 102 103.8 95.5L116.3 108C108.3 118.2 96.2 124.6 82.7 124.6C54.7 124.6 32 101.9 32 73.9C32 45.9 54.7 23.2 82.7 23.2C96.2 23.2 108.3 29.6 116.3 39.8Z"
                fill="#00599C"
              />
              {skill.name === "C++" && (
                <>
                  <path
                    d="M101.3 71.3H89.8V59.8H84V71.3H72.5V77H84V88.5H89.8V77H101.3V71.3Z"
                    fill="#00599C"
                  />
                  <path
                    d="M128 71.3H116.5V59.8H110.7V71.3H99.2V77H110.7V88.5H116.5V77H128V71.3Z"
                    fill="#00599C"
                  />
                </>
              )}
            </svg>
          )}
          <span class="font-medium text-slate-700 dark:text-slate-200 text-sm text-center">
            {skill.name}
          </span>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 mt-3 rounded-full overflow-hidden">
            <div class={skill.barClass} style={`width: ${skill.width}%`} />
          </div>
          <span class="text-[10px] text-slate-400 mt-1 uppercase tracking-wider font-semibold">
            {skill.level}
          </span>
        </div>
      ))}
    </div>
  </div>
</Layout>
