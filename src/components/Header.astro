---
import HeaderLink from "./HeaderLink.astro";
import guIcon from "../assets/gu-icon.png";
import { Image } from "astro:assets";
import { useTranslations, localizePath, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  alternateUrl: string;
}

const { lang, alternateUrl } = Astro.props;
const t = useTranslations(lang);

const homeHref = localizePath("/", lang);
const blogHref = localizePath("/blog", lang);
const projectsHref = localizePath("/projects", lang);
const aboutHref = localizePath("/about", lang);
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-dark/90 backdrop-blur-md border-b border-gray-100 dark:border-dark-border">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <a href={homeHref} class="flex-shrink-0 flex items-center gap-4 group">
        <Image
          src={guIcon}
          alt="Logo"
          class="w-10 h-10 rounded-md transition-transform group-hover:scale-105"
        />
        <span class="font-bold text-2xl tracking-tight group-hover:text-primary transition-colors text-slate-900 dark:text-slate-100">
          {t("site.title")}
        </span>
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center space-x-6">
        <HeaderLink
          href={blogHref}
          class="nav-item text-lg text-slate-600 dark:text-slate-300 hover:text-primary transition-colors font-medium"
        >
          {t("nav.blogs")}
        </HeaderLink>
        <HeaderLink
          href={projectsHref}
          class="nav-item text-lg text-slate-600 dark:text-slate-300 hover:text-primary transition-colors font-medium"
        >
          {t("nav.projects")}
        </HeaderLink>
        <HeaderLink
          href={aboutHref}
          class="nav-item text-lg text-slate-600 dark:text-slate-300 hover:text-primary transition-colors font-medium"
        >
          {t("nav.about")}
        </HeaderLink>

        <div class="relative group" id="search-container">
          <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 text-xs"></i>
          <input
            id="search-input"
            type="text"
            placeholder={t("nav.search.placeholder")}
            class="pl-8 pr-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 border-none text-sm text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-sky-500 focus:bg-white dark:focus:bg-dark-surface w-40 focus:w-60 transition-all duration-300 placeholder-slate-400"
            autocomplete="off"
          />
          <div
            id="search-results"
            class="absolute top-full right-0 mt-2 w-80 bg-white dark:bg-dark-surface rounded-xl shadow-xl border border-gray-100 dark:border-dark-border overflow-hidden hidden z-50 max-h-96 overflow-y-auto"
          ></div>
        </div>

        <div class="h-6 w-px bg-gray-200 dark:bg-slate-700 mx-2"></div>
        <div class="flex items-center space-x-1">
          <a
            href={alternateUrl}
            class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 focus:outline-none transition-colors font-medium text-sm"
            aria-label={t("nav.langLabel")}
          >
            {t("nav.switchLang")}
          </a>
          <button
            id="theme-toggle"
            class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 focus:outline-none transition-colors"
          >
            <i class="far fa-moon !hidden dark:!inline-block"></i>
            <i class="far fa-sun !inline-block dark:!hidden"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center gap-4">
        <button
          id="mobile-menu-btn"
          class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none"
        >
          <i class="fas fa-bars text-xl"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-white dark:bg-dark-surface border-b border-gray-100 dark:border-dark-border"
  >
    <div class="px-4 py-4 space-y-4">
      <HeaderLink
        href={blogHref}
        class="block text-lg text-slate-600 dark:text-slate-300 hover:text-primary transition-colors font-medium"
      >
        {t("nav.blogs")}
      </HeaderLink>
      <HeaderLink
        href={projectsHref}
        class="block text-lg text-slate-600 dark:text-slate-300 hover:text-primary transition-colors font-medium"
      >
        {t("nav.projects")}
      </HeaderLink>
      <HeaderLink
        href={aboutHref}
        class="block text-lg text-slate-600 dark:text-slate-300 hover:text-primary transition-colors font-medium"
      >
        {t("nav.about")}
      </HeaderLink>

      <div class="border-t border-gray-100 dark:border-dark-border pt-4 flex items-center justify-between">
        <a
          href={alternateUrl}
          class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 focus:outline-none transition-colors font-medium text-sm flex items-center gap-2"
          aria-label={t("nav.langLabel")}
        >
          <i class="fas fa-language text-lg"></i>
          {t("nav.switchLang.mobile")}
        </a>

        <button
          id="mobile-theme-toggle"
          class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 focus:outline-none transition-colors flex items-center gap-2"
        >
          <div class="dark:hidden flex items-center gap-2">
            <i class="far fa-moon"></i>
            <span>Dark Mode</span>
          </div>
          <div class="hidden dark:flex items-center gap-2">
            <i class="far fa-sun"></i>
            <span>Light Mode</span>
          </div>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Pagefind is generated into /pagefind/ after `astro build` runs.
  // It is not available during `astro dev`, so search is a no-op in dev.
  let pagefind: any = null;
  let pagefindLang: string | null = null;
  let pagefindLoading: Promise<void> | null = null;

  async function loadPagefind(lang: string) {
    // Pagefind loads the index matching `<html lang>` at init time. Because the
    // module instance persists across View Transitions navigations, we key it
    // to a language and reload a fresh instance when the language changes
    // (using a per-language URL so the ES module cache returns a new instance).
    if (pagefindLang === lang && (pagefind || pagefindLoading)) {
      return pagefindLoading ?? undefined;
    }
    pagefind = null;
    pagefindLang = lang;
    pagefindLoading = (async () => {
      try {
        // The import goes through `new Function` so Vite does not bundle or
        // transform it (which injects a broken __VITE_PRELOAD__ marker).
        const url =
          new URL("/pagefind/pagefind.js", window.location.origin).href +
          "?lang=" +
          lang;
        const importModule = new Function("u", "return import(u)");
        const module = await importModule(url);
        await module.init();
        pagefind = module;
      } catch {
        pagefind = null;
      }
    })();
    return pagefindLoading;
  }

  function initHeader() {
    const currentLang = document.documentElement.lang === "zh" ? "zh" : "en";
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const searchResults = document.getElementById("search-results");

    searchInput?.addEventListener("focus", () => loadPagefind(currentLang), {
      once: true,
    });

    // Enter jumps to the full search results page with the query prefilled.
    searchInput?.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const query = searchInput.value.trim();
      if (query.length < 1) return;
      const base = currentLang === "zh" ? "/zh/search" : "/search";
      window.location.href = `${base}?q=${encodeURIComponent(query)}`;
    });

    let debounce: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener("input", () => {
      clearTimeout(debounce);
      debounce = setTimeout(async () => {
        const query = searchInput.value.trim();

        if (query.length < 2) {
          searchResults?.classList.add("hidden");
          return;
        }

        await loadPagefind(currentLang);
        if (!pagefind || !searchResults) return;

        const search = await pagefind.search(query);
        const results = await Promise.all(
          search.results.slice(0, 6).map((r: any) => r.data()),
        );

        if (results.length > 0) {
          searchResults.innerHTML = results
            .map(
              (post: any) => `
                  <a href="${post.url}" class="block p-4 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors border-b border-gray-100 dark:border-dark-border last:border-0">
                      <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-1">${post.meta?.title ?? ""}</h4>
                      <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2">${post.excerpt}</p>
                  </a>
              `,
            )
            .join("");
          searchResults.classList.remove("hidden");
        } else {
          searchResults.innerHTML = `
                  <div class="p-4 text-sm text-slate-500 dark:text-slate-400 text-center">
                      ${currentLang === "zh" ? "未找到结果" : "No results found"}
                  </div>
              `;
          searchResults.classList.remove("hidden");
        }
      }, 200);
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (
        !document.getElementById("search-container")?.contains(e.target as Node)
      ) {
        searchResults?.classList.add("hidden");
      }
    });

    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    mobileMenuBtn?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
      const icon = mobileMenuBtn.querySelector("i");
      if (mobileMenu?.classList.contains("hidden")) {
        icon?.classList.remove("fa-times");
        icon?.classList.add("fa-bars");
      } else {
        icon?.classList.remove("fa-bars");
        icon?.classList.add("fa-times");
      }
    });

    function toggleTheme() {
      document.documentElement.classList.toggle("dark");
      localStorage.theme = document.documentElement.classList.contains("dark")
        ? "dark"
        : "light";
    }

    // Theme Toggle (Desktop)
    document
      .getElementById("theme-toggle")
      ?.addEventListener("click", toggleTheme);

    // Theme Toggle (Mobile)
    document
      .getElementById("mobile-theme-toggle")
      ?.addEventListener("click", toggleTheme);
  }

  // Initialize on initial load and View Transitions navigation
  document.addEventListener("astro:page-load", initHeader);
</script>
