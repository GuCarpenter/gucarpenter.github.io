---
import Layout from "./Layout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import { calculateReadingTime } from "../utils/readingTime";
import { useTranslations, localizePath, type Lang } from "../i18n/utils";

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  alternateUrl,
  body,
  headings,
  tags,
  category,
  prevPost,
  nextPost,
  id,
  lastModified,
} = Astro.props;

const lang = (Astro.props.lang ?? "en") as Lang;
const t = useTranslations(lang);
const blogHref = localizePath("/blog", lang);

const readingTime = body ? calculateReadingTime(body) : 1;

const ogImagePath = id ? `/og/${id}.png` : undefined;

// Prefer an explicit updatedDate; otherwise fall back to the git-derived
// last-modified timestamp injected by the remarkModifiedTime plugin.
const modifiedDate = updatedDate
  ? new Date(updatedDate)
  : lastModified
    ? new Date(lastModified)
    : null;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImagePath
  ? new URL(ogImagePath, Astro.site).toString()
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  inLanguage: lang === "zh" ? "zh-CN" : "en",
  datePublished: pubDate?.toISOString?.() ?? new Date(pubDate).toISOString(),
  dateModified: modifiedDate
    ? modifiedDate.toISOString()
    : (pubDate?.toISOString?.() ?? new Date(pubDate).toISOString()),
  ...(ogImageUrl ? { image: [ogImageUrl] } : {}),
  ...(tags && tags.length > 0 ? { keywords: tags.join(", ") } : {}),
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl.toString() },
  url: pageUrl.toString(),
  author: {
    "@type": "Person",
    name: "GuCarpenter",
    url: "https://github.com/GuCarpenter",
  },
  publisher: {
    "@type": "Organization",
    name: "GuCarpenter's Cabin",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", Astro.site).toString(),
    },
  },
};

const displayCategory = category
  ? category.replace(/_/g, " ").replace(/\b\w/g, (l: string) => l.toUpperCase())
  : t("post.article");

const tocHeadings = headings
  ? headings.filter(
      (h: { depth: number; text: string; slug: string }) =>
        h.depth <= 3 && !h.text.includes("$") && !h.text.includes("\\"),
    )
  : [];
---

<Layout
  title={title}
  description={description}
  type="post"
  lang={lang}
  alternateUrl={alternateUrl}
  ogImagePath={ogImagePath}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  ></script>
  <!-- Sidebar Slot: Table of Contents -->
  <div
    slot="sidebar"
    class="bg-white dark:bg-dark-surface p-6 rounded-2xl border border-gray-100 dark:border-dark-border"
  >
    <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-4">
      {title}
    </h3>
    <nav class="space-y-3 text-sm">
      {tocHeadings.map(
        (heading: { depth: number; text: string; slug: string }) => (
          <a
            href={`#${heading.slug}`}
            class={`block transition-colors hover:text-sky-500 text-slate-600 dark:text-slate-400 ${heading.depth === 3 ? "pl-4" : "font-medium"}`}
          >
            {heading.text}
          </a>
        ),
      )}
    </nav>
  </div>

  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-1 bg-sky-500 z-[60] transition-[width] duration-75"
    style="width:0"
    data-pagefind-ignore
  ></div>

  <!-- Main Content -->
  <article data-pagefind-body>
    <header class="mb-10">
      <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400 mb-4">
        <FormattedDate date={pubDate} lang={lang} />
        {modifiedDate && (
          <div class="last-updated-on">
            {t("post.lastUpdated")}{" "}
            <FormattedDate date={modifiedDate} lang={lang} />
          </div>
        )}
        <span>•</span>
        <a
          href={`${blogHref}/topics/${category || ""}`}
          class="text-sky-600 dark:text-sky-400 font-medium hover:underline"
        >
          {displayCategory}
        </a>
        <span>•</span>
        <span>
          {readingTime} {t("blog.readingTime")}
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 mb-6 leading-tight">
        {title}
      </h1>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {tags.map((tag: string) => (
            <a
              href={`${blogHref}/topics/${tag}`}
              class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-50 text-sky-700 dark:bg-sky-900/20 dark:text-sky-300 border border-sky-100 dark:border-sky-900/30 hover:bg-sky-100 dark:hover:bg-sky-900/40 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
      {heroImage && (
        <Image
          src={heroImage}
          width={1020}
          height={510}
          alt={title}
          loading="eager"
          class="rounded-2xl shadow-lg mb-8"
        />
      )}
    </header>

    {tocHeadings.length > 0 && (
      <details
        class="lg:hidden mb-10 bg-slate-50 dark:bg-dark-surface p-4 rounded-xl border border-slate-200 dark:border-dark-border group"
        data-pagefind-ignore
      >
        <summary class="font-bold text-slate-900 dark:text-slate-100 cursor-pointer flex items-center justify-between list-none">
          <span class="flex items-center gap-2">
            <i class="fas fa-list-ul text-sky-500" />
            {t("post.toc")}
          </span>
          <i class="fas fa-chevron-down text-xs transition-transform group-open:rotate-180" />
        </summary>
        <nav class="mt-4 space-y-3 text-sm border-t border-slate-200 dark:border-dark-border pt-4">
          {tocHeadings.map(
            (heading: { depth: number; text: string; slug: string }) => (
              <a
                href={`#${heading.slug}`}
                class={`block transition-colors hover:text-sky-500 text-slate-600 dark:text-slate-400 ${heading.depth === 3 ? "pl-4" : "font-medium"}`}
              >
                {heading.text}
              </a>
            ),
          )}
        </nav>
      </details>
    )}

    <div class="prose prose-lg dark:prose-invert prose-headings:font-bold prose-a:text-sky-600 dark:prose-a:text-sky-400 hover:prose-a:text-sky-500">
      <slot />
    </div>

    <!-- Back to Top -->
    <div class="mt-12 flex justify-center" data-pagefind-ignore>
      <button
        onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
        class="group flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400 transition-colors"
      >
        <i class="fas fa-arrow-up group-hover:-translate-y-1 transition-transform"></i>
        {t("post.backToTop")}
      </button>
    </div>

    <!-- Post Navigation -->
    <div
      class="mt-12 pt-12 border-t border-gray-100 dark:border-dark-border grid grid-cols-1 sm:grid-cols-2 gap-6"
      data-pagefind-ignore
    >
      {prevPost ? (
        <a
          href={prevPost.slug}
          class="group flex flex-col items-start gap-2 text-left p-4 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800/50 transition-colors"
        >
          <span class="text-xs text-slate-400 font-medium uppercase tracking-wide group-hover:text-sky-500 transition-colors">
            <i class="fas fa-arrow-left mr-1" /> {t("post.prev")}
          </span>
          <span class="font-bold text-slate-700 dark:text-slate-200 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
            {prevPost.title}
          </span>
        </a>
      ) : (
        <div />
      )}
      {nextPost && (
        <a
          href={nextPost.slug}
          class="group flex flex-col items-end gap-2 text-right p-4 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800/50 transition-colors"
        >
          <span class="text-xs text-slate-400 font-medium uppercase tracking-wide group-hover:text-sky-500 transition-colors">
            {t("post.next")} <i class="fas fa-arrow-right ml-1" />
          </span>
          <span class="font-bold text-slate-700 dark:text-slate-200 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
            {nextPost.title}
          </span>
        </a>
      )}
    </div>

    <section
      id="giscus-container"
      class="mt-16 pt-10 border-t border-gray-100 dark:border-dark-border"
      data-pagefind-ignore
    ></section>

    <script is:inline>
      function loadGiscus() {
        const container = document.getElementById("giscus-container");
        if (!container) return;

        // Clear existing content
        container.innerHTML = "";

        const script = document.createElement("script");
        script.src = "https://giscus.app/client.js";
        script.setAttribute("data-repo", "GuCarpenter/gucarpenter.github.io");
        script.setAttribute("data-repo-id", "MDEwOlJlcG9zaXRvcnkzNjE3OTMxMA==");
        script.setAttribute("data-category", "Announcements");
        script.setAttribute("data-category-id", "DIC_kwDOAigNbs4C0s8x");
        script.setAttribute("data-mapping", "pathname");
        script.setAttribute("data-strict", "0");
        script.setAttribute("data-reactions-enabled", "1");
        script.setAttribute("data-emit-metadata", "0");
        script.setAttribute("data-input-position", "bottom");
        script.setAttribute("data-theme", "preferred_color_scheme");
        script.setAttribute(
          "data-lang",
          document.documentElement.lang === "zh" ? "zh-CN" : "en",
        );
        script.setAttribute("crossorigin", "anonymous");
        script.async = true;

        container.appendChild(script);
      }

      function updateGiscusTheme() {
        const theme = document.documentElement.classList.contains("dark")
          ? "dark"
          : "light";
        const iframe = document.querySelector("iframe.giscus-frame");
        if (!iframe) return;
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: theme } } },
          "https://giscus.app",
        );
      }

      // Sync theme on toggle
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === "class") {
            updateGiscusTheme();
          }
        });
      });
      observer.observe(document.documentElement, { attributes: true });

      // Load on initial load and navigation
      document.addEventListener("astro:page-load", loadGiscus);
    </script>
  </article>

  <script>
    function initReadingAids() {
      const bar = document.getElementById("reading-progress");
      const article = document.querySelector("article");

      // Reading progress bar
      const onScroll = () => {
        if (!bar || !article) return;
        const articleTop = article.offsetTop;
        const scrollable =
          article.offsetHeight - (window.innerHeight - articleTop);
        const scrolled = window.scrollY - articleTop;
        const pct = Math.min(
          100,
          Math.max(0, (scrolled / Math.max(1, scrollable)) * 100),
        );
        bar.style.width = pct + "%";
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // TOC scrollspy
      const tocLinks = Array.from(
        document.querySelectorAll('nav a[href^="#"]'),
      ) as HTMLAnchorElement[];
      const active = "text-sky-500";
      const map = new Map<string, HTMLAnchorElement[]>();
      for (const link of tocLinks) {
        const id = decodeURIComponent(link.hash.slice(1));
        if (!id) continue;
        if (!map.has(id)) map.set(id, []);
        map.get(id)!.push(link);
      }

      const headings = [...map.keys()]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => Boolean(el));

      if (headings.length === 0) return;

      let currentId: string | null = null;
      const setActive = (id: string) => {
        if (id === currentId) return;
        currentId = id;
        tocLinks.forEach((l) => l.classList.remove(active));
        map.get(id)?.forEach((l) => l.classList.add(active));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort(
              (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
            );
          if (visible[0]?.target?.id) setActive(visible[0].target.id);
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
      );
      headings.forEach((h) => observer.observe(h));
    }

    document.addEventListener("astro:page-load", initReadingAids);
  </script>
</Layout>
