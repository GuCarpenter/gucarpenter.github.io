---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { postSlug, localizePath } from "../../i18n/utils";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const posts = allPosts.filter((p) => p.data.lang === "en");

  const sortedPosts = posts.sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
  );

  return sortedPosts.map((post) => {
    // Alternate language: the matching `-zh` entry, if it exists.
    const zhId = post.id + "-zh";
    const hasZh = allPosts.some((p) => p.id === zhId);
    const alternateUrl = hasZh
      ? localizePath(`/blog/${postSlug(zhId)}/`, "zh")
      : localizePath("/blog", "zh");

    const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
    const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
    const nextPost =
      currentIndex < sortedPosts.length - 1
        ? sortedPosts[currentIndex + 1]
        : null;

    return {
      params: { slug: post.id },
      props: {
        ...post,
        alternateUrl,
        prevPost: prevPost
          ? { title: prevPost.data.title, slug: `/blog/${prevPost.id}/` }
          : null,
        nextPost: nextPost
          ? { title: nextPost.data.title, slug: `/blog/${nextPost.id}/` }
          : null,
      },
    };
  });
}

type Props = CollectionEntry<"blog"> & {
  alternateUrl: string;
  prevPost: { title: string; slug: string } | null;
  nextPost: { title: string; slug: string } | null;
};

const { alternateUrl, prevPost, nextPost, ...post } = Astro.props;
const { Content, headings } = await render(post);

const category = post.id.includes("/") ? post.id.split("/")[0] : null;
---

<BlogPost
  {...post.data}
  lang="en"
  id={post.id}
  body={post.body}
  alternateUrl={alternateUrl}
  headings={headings}
  category={category}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPost>
